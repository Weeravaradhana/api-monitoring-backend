// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum HttpMethod {
  GET
  POST
  PUT
  DELETE
  PATCH
  HEAD
}

enum Role {
  USER
  ORGANIZER
  ADMIN
}

enum MonitorStatus {
  ACTIVE
  PAUSED
  DELETED
}

enum TenantType {
  PERSONAL
  ORGANIZATION
}

model WebhookConfig {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  url         String
  isActive    Boolean  @default(true)
  secretToken String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
}

model SlackConfig {
  id          String   @id @default(uuid())
  tenantId    String   @unique
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  webhookUrl  String
  channelName String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
}

model Tenant {
  id        String     @id @default(uuid())
  name      String     @db.VarChar(255)
  type      TenantType @default(PERSONAL)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  users       User[]
  monitors    Monitor[]
  webhooks    WebhookConfig[]
  slackConfig SlackConfig?
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  firstName    String?
  lastName     String?
  role         Role     @default(ORGANIZER)
  isVerified   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  alertsMutedUntil DateTime?

  refreshTokens    RefreshToken[]
  otpVerifications OtpVerification[]
  passwordResets   PasswordResetToken[]

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([tenantId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  isRevoked Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([tokenHash])
}

model OtpVerification {
  id        String   @id @default(uuid())
  codeHash  String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([tokenHash])
}

model Monitor {
  id        String        @id @default(uuid())
  name      String        @db.VarChar(255)
  url       String        @db.Text
  method    HttpMethod    @default(GET)
  interval  Int           @default(60)
  timeout   Int           @default(30)
  headers   Json          @default("{}")
  body      String?       @db.Text
  status    MonitorStatus @default(ACTIVE)
  nextRunAt DateTime      @default(now())
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  lastState String        @default("UP")

  lastNotificationaAt DateTime?
  notifyEmail         String?

  tenantId         String
  tenant           Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  results          MonitoringResult[]
  notificationLogs NotificationLog[]

  @@index([tenantId])
  @@index([status, nextRunAt])
}

model MonitoringResult {
  monitorId    String
  statusCode   Int?     @db.SmallInt
  responseTime Int
  success      Boolean
  errorMessage String?  @db.Text
  checkedAt    DateTime @default(now())

  monitor Monitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@id([monitorId, checkedAt])
  @@index([monitorId, checkedAt(sort: Desc)])
}

model NotificationLog {
  id           String   @id @default(uuid())
  monitorId    String
  stateSent    String
  sentTo       String
  sentAt       DateTime @default(now())
  success      Boolean  @default(true)
  errorMessage String?  @db.Text

  monitor Monitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@index([monitorId])
}
